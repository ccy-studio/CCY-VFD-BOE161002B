 327          void btn_handler(btn_t* btn) {
 328   1          if (btn->last_press_time >= BTN_LONG_PRESS_MS &&
 329   1              btn->btn_type == BTN_PRESS) {
 330   2              btn->last_press_time += BTN_SCAN_MS;
 331   2              return;
 332   2          }
 333   1          if (!btn_gpio_read(btn->gpio)) {
 334   2              // 按下触发
 335   2              if (btn->btn_type == BTN_PRESS) {
 336   3                  btn->last_press_time += BTN_SCAN_MS;
 337   3              } else if (btn->btn_type == BTN_RELEASE) {
 338   3                  btn->last_press_time = 0;
 339   3                  btn->btn_type = BTN_PRESS;
 340   3                  // send message
 341   3                  btn->falg = 1;
 342   3                  return;
 343   3              }
 344   2              if (btn->btn_type == BTN_PRESS &&
 345   2                  btn->last_press_time >= BTN_LONG_PRESS_MS) {
 346   3                  // long press event
 347   3                  btn->btn_type = BTN_LONG;
 348   3                  btn->last_press_time += BTN_SCAN_MS;
 349   3                  // send message
 350   3                  btn->falg = 1;
 351   3                  return;
 352   3              }
 353   2          } else {
 354   2              // release
 355   2              btn->btn_type = BTN_RELEASE;
 356   2              btn->last_press_time = 0;
 357   2          }
 358   1      }
