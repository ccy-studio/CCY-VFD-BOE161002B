  55          void start_pwm() {
  56   1          /*  PWM 输出频率 = 系统时钟 SYSclk / ((PWM_PSCR + 1) * (PWM_ARR + 1))
  57   1              PWM 输出频率 = 24 MHz / ((0 + 1) * (100 + 1))
  58   1                   = 24 MHz / 101
  59   1                   ≈ 237.62 kHz
  60   1           */
  61   1          PWMA_PS = 0x00;
  62   1          PWMA_CCER1 = 0x00;    // 写CCMRx前必须先清零CCERx关闭通道
  63   1          PWMA_CCMR2 = 0x68;    // 设置CC2为PWMA输出模式
  64   1          PWMA_CCER1 = 0x40;    // 使能CC2通道
  65   1          PWMA_PSCR = 0x0000;   // 不分频
  66   1          PWMA_ARR = PWM_ARR;   // 设置周期时间
  67   1          PWMA_CCR2 = PWM_CCR;  // 设置占空比时间
  68   1          PWMA_ENO = 0x08;      // 使能PWM2P端口输出
  69   1          PWMA_BKR = 0x80;      // 使能主输出
  70   1          PWMA_CR1 |= 0x81;     // 开始计时
  71   1      }
  72          
  73          void stop_pwm() {
  74   1          PWMA_CR1 &= 0xFE;  // 关闭定时器
  75   1          PWMA_ENO = 0x00;   // 禁止使能
  76   1      }
  77          
