 152          long map(long x, long in_min, long in_max, long out_min, long out_max) {
 153   1          const long dividend = out_max - out_min;
 154   1          const long divisor = in_max - in_min;
 155   1          const long delta = x - in_min;
 156   1          return (delta * dividend + (divisor / 2)) / divisor + out_min;
 157   1      }
