              #define SDA_1 I2C_SDA = 1
              #define SDA_0 I2C_SDA = 0
              
              #define SCL_1 I2C_SCL = 1
              #define SCL_0 I2C_SCL = 0
              
              static void i2c_sda_out() {
                  P2M0 |= 0x10;
                  P2M1 |= 0x10;
              }
              
              static void i2c_sda_in() {
                  P2M1 |= 0x10;
                  P2M0 &= ~0x10;
              }
              
              void i2c_init() {
                  // 设置 SDA、SCL开漏输出
                  P2M0 |= 0x30;
                  P2M1 |= 0x30;
                  i2c_sda_out();
              }
              
              bool i2c_start(void) {
                  i2c_sda_out();
                  SDA_1;
                  SCL_1;
                  delay_us(4);
                  SDA_0;
                  delay_us(4);
                  SCL_0;
                  return true;
              }
              void i2c_stop(void) {
                  i2c_sda_out();
                  SCL_0;
                  SDA_0;
                  SCL_1;
                  delay_us(4);
                  SDA_1;
                  delay_us(4);
              }
              
              void i2c_nack() {
                  i2c_sda_out();
                  SDA_1;
                  SCL_0;
                  delay_us(4);
                  SCL_1;
C51 COMPILER V9.60.7.0   I2C                                                               06/25/2024 16:07:33 PAGE 3   

                  delay_us(4);
                  SCL_0;
              }
              
              void i2c_ack() {
                  i2c_sda_out();
                  SDA_0;
                  SCL_0;
                  delay_us(4);
                  SCL_1;
                  delay_us(4);
                  SCL_0;
              }
              
              u8 i2c_check_ack() {
                  uint8_t ack = 0, errorRetry = 3;
                  SDA_1;
                  delay_us(1);
                  i2c_sda_in();
                  delay_us(1);
                  SCL_1;
                  delay_us(1);
                  while (I2C_SDA) {
                      if (errorRetry <= 0) {
                          break;
                      }
                      delay_us(1);
                      errorRetry--;
                  }
                  if (errorRetry) {
                      ack = 1;
                  }
                  if (!ack) {
                      i2c_stop();
                  }
                  SCL_0;
                  return ack;
              }
              u8 i2c_read(bool ack) {
                  uint8_t receiveData = 0, i;
                  i2c_sda_in();
                  for (i = 0; i < 8; i++) {
                      SCL_0;
                      delay_us(4);
                      SCL_1;
                      receiveData <<= 1;
                      if (I2C_SDA) {
                          receiveData |= 0x01;
                      }
                      delay_us(1);
                  }
                  SCL_0;
                  ack ? i2c_ack() : i2c_nack();
                  return receiveData;
              }
              
              bool i2c_send(u8 buf) {
                  u8 i;
                  i2c_sda_out();
                  SCL_0;
                  delay_us(4);
                  for (i = 0; i < 8; i++) {
C51 COMPILER V9.60.7.0   I2C                                                               06/25/2024 16:07:33 PAGE 4   

                      if (buf & 0x80) {
                          SDA_1;
                      } else {
                          SDA_0;
                      }
                      delay_us(4);
                      SCL_1;
                      delay_us(4);
                      SCL_0;
                      buf <<= 1;
                  }
                  return i2c_check_ack();
              }
              
